# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API Keys
FINNHUB_API_KEY=your_finnhub_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
NEWS_API_KEY=your_newsapi_key
# Optional — without this, the Bottom Line verdict / per-signal explanations /
# Ask Claude all fall back to rule-based text instead of Claude-written bullets
# (noiseScore.js / signalExplainer.js / aiTakeScore.js)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional — E*TRADE position sync (Settings > Connect E*TRADE). Without
# these, that section just shows setup instructions instead of a Connect
# button. Register a free app at developer.etrade.com to get real values.
# ETRADE_ENV defaults to "sandbox" (fake test data) — must be explicitly set
# to "live" to ever touch a real account.
ETRADE_CONSUMER_KEY=your_etrade_consumer_key
ETRADE_CONSUMER_SECRET=your_etrade_consumer_secret
ETRADE_ENV=sandbox

# Optional — a single shared access code required on every request (see
# AccessGate.jsx on the frontend). Unset = no gate (fine for local dev).
# Pick your own value; not a real password, just keeps random visitors out.
ACCESS_CODE=your_chosen_access_code

# Optional — lets a newly tracked stock get an immediate, single-ticker
# data fetch (via GitHub Actions workflow_dispatch) instead of waiting for
# the next scheduled run. Needs a token with Actions read/write permission
# on this repo — Settings -> Developer settings -> Personal access tokens
# (fine-grained) on GitHub, scoped to this repo only. Without it, tracking
# a new stock still works fine, it just waits for the normal schedule.
GITHUB_ACTIONS_PAT=your_github_token

# Server
PORT=5000
